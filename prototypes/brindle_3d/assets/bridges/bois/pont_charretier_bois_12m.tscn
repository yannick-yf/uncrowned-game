[node name="PontCharretierBois12m" type="Node3D" unique_id=27828781]
metadata/asset_id = "pont_charretier_bois_12m"
metadata/family = "bois"
metadata/label = "Pont de transport en bois · 12 m"
metadata/purpose = "Tablier de madriers, ferrures et chevalets contreventés. Passage large pour les charrettes de minerai ou de bois."
metadata/placement = "Raccorder les deux repères Entry / Exit aux berges ; enterrer les pieds et culées jusqu’au lit."
metadata/length_m = 12.0
metadata/clear_width_m = 3.4

